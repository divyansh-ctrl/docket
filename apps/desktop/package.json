{
  "name": "aos-desktop",
  "productName": "AOS",
  "version": "0.1.0",
  "description": "A secure local desktop control plane for Codex and Claude Code.",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-native-modules.mjs",
    "prepare:native": "node scripts/prepare-native-modules.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prestart": "node scripts/prepare-native-modules.mjs",
    "start": "electron-forge start",
    "prepackage": "node scripts/prepare-native-modules.mjs",
    "package": "electron-forge package",
    "premake": "node scripts/prepare-native-modules.mjs",
    "make": "electron-forge make",
    "make:mac": "npm run prepare:native && electron-forge make --platform=darwin --arch=arm64,x64 && node scripts/create-macos-dmg.mjs",
    "make:mac:arm64": "npm run prepare:native && electron-forge make --platform=darwin --arch=arm64 && node scripts/create-macos-dmg.mjs --arch=arm64",
    "make:mac:x64": "npm run prepare:native && electron-forge make --platform=darwin --arch=x64 && node scripts/create-macos-dmg.mjs --arch=x64",
    "make:win": "npm run prepare:native && electron-forge make --platform=win32 --arch=x64",
    "make:linux": "npm run prepare:native && electron-forge make --platform=linux --arch=x64",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.31.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.4.0",
    "eslint": "9.39.4",
    "globals": "14.0.0",
    "jiti": "2.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.1"
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
