{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docket",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker sees /download/* first so it can stream installers itself.
    // Everything else falls through to the static files.
    "run_worker_first": ["/download/*"]
  },
  "vars": {
    // Private build storage, used only until an R2 bucket is bound. The
    // matching token is a secret: npx wrangler secret put BUILD_TOKEN
    "BUILD_REPO": "divyansh-ctrl/docket"
  }
  // Preferred storage, once R2 is enabled on the account:
  //   npx wrangler r2 bucket create docket-downloads
  // then uncomment this and the Worker uses it instead of build storage.
  // "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "docket-downloads" }]
}
